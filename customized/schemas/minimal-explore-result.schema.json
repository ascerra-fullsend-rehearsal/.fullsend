{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Minimal Explore Result",
  "description": "Lightweight exploration summary for rehearsal testing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "issue", "repo", "findings", "confidence", "summary"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "needs_input", "error"]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "summary"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "description", "primary_language", "top_level_entries"],
      "properties": {
        "full_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "primary_language": { "type": "string", "maxLength": 80 },
        "top_level_entries": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "related_issues": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "relevance"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "relevance": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
